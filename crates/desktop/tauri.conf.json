{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaliCanon",
  "version": "0.1.0",
  "identifier": "app.palicanon.learn",
  "build": {
    "frontendDist": "../../target/dist",
    "beforeBuildCommand": {
      "script": "trunk build --release --cargo-profile wasm-release",
      "cwd": "../front",
      "wait": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PaliCanon",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
